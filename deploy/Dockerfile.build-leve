# VERKZ Office: servidor + versão de navegador (v0.5.0).
# Os modelos 3D (CC0) são baixados no build: KayKit do GitHub, Kenney do npm.
FROM node:22-slim AS web
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
RUN npm i --no-save --no-audit --no-fund @netforge/asset-library-files@0.2.0
COPY web/ ./
COPY kaykit-files.txt /tmp/
RUN git clone -q --depth 1 https://github.com/KayKit-Game-Assets/KayKit-Furniture-Bits-1.0.git /tmp/fb \
 && git clone -q --depth 1 https://github.com/KayKit-Game-Assets/KayKit-Restaurant-Bits-1.0.git /tmp/rb \
 && mkdir -p public/models/kaykit public/models/kaykit-restaurant public/models/kenney \
 && while read f; do \
      dir=$(dirname "$f"); name=$(basename "$f" .gltf); \
      src=/tmp/fb/addons/kaykit_furniture_bits/Assets/gltf; [ "$dir" = "kaykit-restaurant" ] && src=/tmp/rb/addons/kaykit_restaurant_bits/Assets/gltf; \
      cp "$src/$name.gltf" "$src/$name.bin" "public/models/$dir/"; \
    done < /tmp/kaykit-files.txt \
 && cp /tmp/fb/addons/kaykit_furniture_bits/Assets/gltf/furniturebits_texture.png public/models/kaykit/ \
 && cp /tmp/rb/addons/kaykit_restaurant_bits/Assets/gltf/restaurantbits_texture.png public/models/kaykit-restaurant/ \
 && cp /tmp/fb/LICENSE* public/models/kaykit/ 2>/dev/null; cp /tmp/rb/LICENSE* public/models/kaykit-restaurant/ 2>/dev/null; \
    for f in bush bush_large flower_red log mini_female_a mini_male_a rock_small stump tree_fat tree_oak tree_pine tree_pine_tall; do \
      cp node_modules/@netforge/asset-library-files/library/lowpoly/$f.glb public/models/kenney/; done \
 && ls public/models/kaykit | wc -l && ls public/models/kaykit-restaurant | wc -l
# ícones do app (não mudaram): vêm da versão publicada
ADD https://office.verkzsystem.tech/icons/icon.svg https://office.verkzsystem.tech/icons/icon-192.png https://office.verkzsystem.tech/icons/icon-512.png https://office.verkzsystem.tech/icons/maskable-512.png https://office.verkzsystem.tech/icons/apple-touch-icon.png public/icons/
RUN npx vite build

FROM rust:1-slim-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd -m office && mkdir /data && chown office /data
COPY --from=build /src/target/release/verkz-office-server /usr/local/bin/
COPY --from=web /app/dist /web
# sons de porta (Kenney RPG Audio, CC0), convertidos para mp3 (toca em todos os navegadores)
ADD "https://raw.githubusercontent.com/Boyquotes/kenney-rpg-audio-for-godot/HEAD/addons/kenney%20rpg%20audio/door_open_1.ogg" /tmp/snd/porta-abrir-1.ogg
ADD "https://raw.githubusercontent.com/Boyquotes/kenney-rpg-audio-for-godot/HEAD/addons/kenney%20rpg%20audio/door_open_2.ogg" /tmp/snd/porta-abrir-2.ogg
ADD "https://raw.githubusercontent.com/Boyquotes/kenney-rpg-audio-for-godot/HEAD/addons/kenney%20rpg%20audio/door_close_2.ogg" /tmp/snd/porta-fechar-1.ogg
ADD "https://raw.githubusercontent.com/Boyquotes/kenney-rpg-audio-for-godot/HEAD/addons/kenney%20rpg%20audio/door_close_4.ogg" /tmp/snd/porta-fechar-2.ogg
RUN mkdir -p /web/sounds && for f in /tmp/snd/*.ogg; do ffmpeg -loglevel error -y -i "$f" -ac 1 -b:a 96k "/web/sounds/$(basename "$f" .ogg).mp3"; done && rm -rf /tmp/snd
USER office
ENV DATA_DIR=/data BIND=0.0.0.0:8080 WEB_DIR=/web
EXPOSE 8080
CMD ["verkz-office-server"]
