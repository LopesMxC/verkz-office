{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VERKZ Office",
  "version": "0.6.8",
  "identifier": "com.verkz.office",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VERKZ Office",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0D0D0D",
        "label": "main",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI --js-flags=--max-old-space-size=160 --disable-background-networking --disable-component-update --disable-extensions --disk-cache-size=33554432"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Escritório virtual da VERKZ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "VERKZ",
    "copyright": "© 2026 VERKZ. Todos os direitos reservados.",
    "homepage": "https://verkzsystem.tech",
    "longDescription": "Escritório virtual da VERKZ: áudio por proximidade, vídeo, compartilhamento de tela e salas para a equipe."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEMjVCRThGMjA2MzI0QzUKUldURkpHTWdqNzRsdlFxVXJrNXdSYTkrT2Q3WHdZbmdlakJpN2VhTExBd1lyTXQ4Wk45MzZPcTYK",
      "endpoints": [
        "https://office.verkzsystem.tech/api/update/{{target}}/{{arch}}/{{current_version}}",
        "https://verkzsystem.tech/apps/verkz-office/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
